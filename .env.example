APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Reti (IP o CIDR, separate da virgola) dei reverse proxy i cui header
# X-Forwarded-* sono attendibili, es. la rete Docker di Dokploy/Traefik.
# Le bridge network di Docker stanno tipicamente in 172.16.0.0/12: verifica
# la CIDR effettiva (es. `docker network inspect <rete>`).
# Vuoto o omesso = nessun proxy fidato, header X-Forwarded-* ignorati.
# NON usare mai CIDR che coprono lo spazio dei client (0.0.0.0/0, ::/0):
# l'app li rifiuta all'avvio, perché chiunque potrebbe falsificare il proprio IP.
# Nota: con config:cache la variabile deve essere un vero env di processo
# (Dokploy: sì); un valore presente solo nel .env locale verrebbe ignorato (fail-safe).
TRUSTED_PROXIES=
# TRUSTED_PROXIES=172.18.0.0/16

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite è il database di riferimento dello stack di produzione: il compose
# forza comunque DB_DATABASE sul volume persistente (storage/app/private).
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Alternativa PostgreSQL: attenzione, i backup cifrati di db:snapshot sono
# progettati per SQLite; passando a pg va ridefinita la strategia backup.
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=pawdesk
# DB_USERNAME=root
# DB_PASSWORD=

# Snapshot cifrati notturni (db:snapshot). La chiave è base64 di 32 byte:
#   php -r "echo base64_encode(random_bytes(32));"
# Da conservare ANCHE fuori host (password manager): senza chiave i backup
# non sono ripristinabili. In sviluppo locale lasciare vuoto = comando disattivo.
BACKUP_SNAPSHOT_KEY=
BACKUP_KEEP=7
BACKUP_ALERT_EMAIL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
